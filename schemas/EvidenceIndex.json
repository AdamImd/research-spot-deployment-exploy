{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "title": "Gate",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unverified"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewed_by": {
          "minLength": 1,
          "title": "Reviewed By",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "status",
        "reviewed_by",
        "recorded_at",
        "expires_at",
        "binding_sha256",
        "artifact",
        "artifact_sha256",
        "note"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "evidence"
  ],
  "title": "EvidenceIndex",
  "type": "object"
}
